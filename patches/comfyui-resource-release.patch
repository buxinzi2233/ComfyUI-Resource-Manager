+import ctypes
 import os
 import sys
 
@@ -10,6 +11,19 @@ PROC_SELF_CGROUP = "/proc/self/cgroup"
 _cgroup_dirs = None
 
 
+def release_unused_memory():
+    """Return unused glibc heap pages after an explicit full resource release."""
+    if not sys.platform.startswith("linux"):
+        return
+    try:
+        malloc_trim = ctypes.CDLL(None).malloc_trim
+    except (AttributeError, OSError):
+        return  # Non-glibc allocators do not expose malloc_trim.
+    malloc_trim.argtypes = [ctypes.c_size_t]
+    malloc_trim.restype = ctypes.c_int
+    malloc_trim(0)
+
