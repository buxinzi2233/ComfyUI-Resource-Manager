@@ -10,6 +10,33 @@ HOST_TOTAL = 128 * GIB
 HOST_AVAILABLE = 100 * GIB
 
 
+@pytest.mark.parametrize("platform", ["darwin", "win32"])
+def test_release_unused_memory_skips_non_linux(monkeypatch, platform):
+    monkeypatch.setattr(sys, "platform", platform)
+
+    def unsupported_allocator(name):
+        raise AssertionError("Linux allocator API must not be loaded on this platform")
+
+    monkeypatch.setattr(system_memory.ctypes, "CDLL", unsupported_allocator)
+    system_memory.release_unused_memory()
+
+
+def test_release_unused_memory_without_glibc(monkeypatch):
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setattr(system_memory.ctypes, "CDLL", lambda name: SimpleNamespace())
+    system_memory.release_unused_memory()
+
+
+def test_release_unused_memory_when_allocator_cannot_be_loaded(monkeypatch):
+    monkeypatch.setattr(sys, "platform", "linux")
+
+    def unavailable_allocator(name):
+        raise OSError("allocator unavailable")
+
+    monkeypatch.setattr(system_memory.ctypes, "CDLL", unavailable_allocator)
+    system_memory.release_unused_memory()
+
